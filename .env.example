# Copier ce fichier en « .env » et l'adapter. Ne jamais versionner le fichier .env.

# --- Authentification de l'API ----------------------------------------------
# oidc (recommandé) : jetons d'accès JWT émis par votre fournisseur d'identité.
IAM_AUTH_MODE=oidc
IAM_OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
IAM_OIDC_AUDIENCE=api://iam-ad
IAM_OIDC_JWKS_URL=https://login.microsoftonline.com/<tenant-id>/discovery/v2.0/keys
IAM_OIDC_REQUIRED_ROLE=iam.users.create

# api_key : une clé par application cliente. Générer avec « iam-ad generate-api-key <nom> »
# et ne placer ici que l'empreinte SHA-256, jamais la clé.
#IAM_AUTH_MODE=api_key
#IAM_API_KEYS={"logiciel-rh": "<empreinte sha-256>"}

# --- Active Directory ---------------------------------------------------------
# ldap : Active Directory réel. memory : démonstration, rien n'est créé.
IAM_DIRECTORY_BACKEND=ldap
# Noms DNS des contrôleurs de domaine (pas d'adresses IP : le certificat est vérifié).
IAM_AD_SERVERS=dc1.corp.exemple.be,dc2.corp.exemple.be
IAM_AD_PORT=636
IAM_AD_BASE_DN=DC=corp,DC=exemple,DC=be
IAM_AD_USERS_OU=OU=Utilisateurs,DC=corp,DC=exemple,DC=be
IAM_AD_UPN_SUFFIX=exemple.be
IAM_AD_BIND_USER=svc-iam@corp.exemple.be
# Mot de passe du compte de service : de préférence par fichier secret
# (/run/secrets/iam_ad_bind_password), sinon par cette variable.
#IAM_AD_BIND_PASSWORD=
# Autorité de certification interne qui a émis le certificat LDAPS des contrôleurs de domaine.
IAM_AD_CA_CERT_FILE=/etc/iam-ad/ca.pem

# --- Règles -------------------------------------------------------------------
IAM_LOGIN_FIRST_NAME_LETTERS=3
IAM_LOGIN_LAST_NAME_LETTERS=3
IAM_PASSWORD_LENGTH=10
#IAM_MATRICULE_PATTERN=^[A-Za-z0-9][A-Za-z0-9._-]{0,15}$
#IAM_MAIL_ALLOWED_DOMAINS=exemple.be

# Page interactive /docs (Swagger UI). Elle charge ses scripts depuis le CDN public jsdelivr :
# à n'activer que si c'est acceptable chez vous. Le contrat /openapi.json est toujours servi.
IAM_ENABLE_DOCS=false
